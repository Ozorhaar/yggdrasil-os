# Yggdrasil OS boot splash
# The world-tree emblem fades in, then the runes of YGGDRASIL kindle
# one after another and keep a slow ember-like pulse until the desktop.

Window.SetBackgroundTopColor(0.043, 0.071, 0.125);
Window.SetBackgroundBottomColor(0.016, 0.024, 0.047);

sw = Window.GetWidth();
sh = Window.GetHeight();
ox = Window.GetX();
oy = Window.GetY();

# ---------------------------------------------------------------- emblem
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = ox + sw / 2 - logo.image.GetWidth() / 2;
logo.y = oy + sh / 2 - logo.image.GetHeight() / 2 - 70;
logo.sprite.SetPosition(logo.x, logo.y, 1);
logo.sprite.SetOpacity(0);

# ---------------------------------------------------------------- runes
spacing = 16;
total_w = 0;
for (i = 0; i < 9; i++) {
    rune[i].image = Image("rune" + i + ".png");
    total_w += rune[i].image.GetWidth() + spacing;
}
total_w -= spacing;
rx = ox + sw / 2 - total_w / 2;
ry = logo.y + logo.image.GetHeight() + 36;
for (i = 0; i < 9; i++) {
    rune[i].sprite = Sprite(rune[i].image);
    rune[i].sprite.SetPosition(rx, ry, 2);
    rune[i].sprite.SetOpacity(0);
    rx += rune[i].image.GetWidth() + spacing;
}

# ---------------------------------------------------------------- state
global.progress = 0;
global.ticks = 0;
global.pw_mode = 0;

fun boot_progress_cb(duration, progress) {
    global.progress = progress;
}
Plymouth.SetBootProgressFunction(boot_progress_cb);

fun refresh_cb() {
    global.ticks++;
    t = global.ticks;

    # emblem fades in over ~1s, then breathes gently
    a = t / 50;
    if (a > 1) a = 0.88 + 0.12 * Math.Cos(t / 40);
    logo.sprite.SetOpacity(a);

    # runes: whichever is further along, real progress or a steady clock
    level = Math.Max(global.progress * 12, (t - 45) / 14);
    for (i = 0; i < 9; i++) {
        r = Math.Clamp(level - i, 0, 1);
        if (r >= 1) r = 0.75 + 0.25 * Math.Cos(t / 25 + i * 0.7);
        rune[i].sprite.SetOpacity(r);
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

# ---------------------------------------------------------------- password (encrypted disks)
prompt.y = ry + 110;

fun display_password_cb(prompt_text, bullets) {
    global.pw_mode = 1;
    global.prompt_image = Image.Text(prompt_text, 0.91, 0.86, 0.77);
    global.prompt_sprite = Sprite(global.prompt_image);
    global.prompt_sprite.SetPosition(ox + sw / 2 - global.prompt_image.GetWidth() / 2, prompt.y, 10);

    global.entry_image = Image("entry.png");
    global.entry_sprite = Sprite(global.entry_image);
    ex = ox + sw / 2 - global.entry_image.GetWidth() / 2;
    ey = prompt.y + 36;
    global.entry_sprite.SetPosition(ex, ey, 10);

    bullet_image = Image("bullet.png");
    for (i = 0; i < 24; i++) {
        if (!global.bullet[i]) global.bullet[i] = Sprite(bullet_image);
        global.bullet[i].SetPosition(ex + 14 + i * 12, ey + 13, 11);
        if (i < bullets) global.bullet[i].SetOpacity(1);
        else global.bullet[i].SetOpacity(0);
    }
}

fun display_normal_cb() {
    if (global.pw_mode) {
        global.prompt_sprite.SetOpacity(0);
        global.entry_sprite.SetOpacity(0);
        for (i = 0; i < 24; i++) {
            if (global.bullet[i]) global.bullet[i].SetOpacity(0);
        }
    }
    global.pw_mode = 0;
}

Plymouth.SetDisplayPasswordFunction(display_password_cb);
Plymouth.SetDisplayNormalFunction(display_normal_cb);

# ---------------------------------------------------------------- messages
fun message_cb(text) {
    global.msg_image = Image.Text(text, 0.56, 0.77, 0.88);
    global.msg_sprite = Sprite(global.msg_image);
    global.msg_sprite.SetPosition(ox + sw / 2 - global.msg_image.GetWidth() / 2, oy + sh - 60, 10);
}
Plymouth.SetMessageFunction(message_cb);
