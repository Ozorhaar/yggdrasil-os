<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\yggdrasil.ico</ApplicationIcon>
    <AssemblyName>YggdrasilSky</AssemblyName>
    <RootNamespace>Yggdrasil.Sky</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Yggdrasil Sky</Product>
    <Description>The living fjord wallpaper for Yggdrasil Windows</Description>

    <!-- One self-contained exe: nothing to install system-wide. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Supply chain: exact versions, lock file, locked restore in CI. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' And Exists('packages.lock.json')">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4314.35]" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scene ships beside the exe in web\ (served to WebView2 from disk, never from the network). -->
    <None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="assets\yggdrasil.ico" />
  </ItemGroup>

</Project>
