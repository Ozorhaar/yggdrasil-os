     }
 
+    signingConfigs {
+        // CI signs with the same private key as the Yggdrasil launcher (kept in GitHub secrets / the Mac)
+        create("ygg") {
+            val ks = System.getenv("YGG_KEYSTORE")
+            if (ks != null) {
+                storeFile = file(ks)
+                storeType = "PKCS12"
+                storePassword = System.getenv("YGG_KEYSTORE_PASSWORD")
+                keyAlias = "yggdrasil"
+                keyPassword = System.getenv("YGG_KEYSTORE_PASSWORD")
+            }
+        }
+    }
+
     buildTypes {
         release {
             isMinifyEnabled = true
@@ -30,6 +45,7 @@ android {
             isJniDebuggable = false
         }
         create("nouserlib") { // same as release, but does not allow the user to provide a library
+            if (System.getenv("YGG_KEYSTORE") != null) signingConfig = signingConfigs.getByName("ygg")
             isMinifyEnabled = true
             isShrinkResources = false
             isDebuggable = false
@@ -66,7 +82,7 @@ android {
             }
             variant.outputs.forEach { output ->
                 if (output is com.android.build.api.variant.impl.VariantOutputImpl) {
-                    output.outputFileName = "HeliBoard_${defaultConfig.versionName}-${variant.buildType}.apk"
+                    output.outputFileName = "YggdrasilKeys_${defaultConfig.versionName}.apk"
                 }
             }
         }
