diff --git a/.github/workflows/yggdrasil-keys.yml b/.github/workflows/yggdrasil-keys.yml
new file mode 100644
index 00000000..d8a8703e
--- /dev/null
+++ b/.github/workflows/yggdrasil-keys.yml
@@ -0,0 +1,62 @@
+name: Yggdrasil Keys
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      # every action is pinned to an exact commit, so a moved tag can't change what runs here
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+
+      - uses: actions/setup-java@c5195efecf7bdfc987ee8bae7a71cb8b11521c00 # v4.7.1
+        with:
+          java-version: '17'
+          distribution: 'temurin'
+
+      # also verifies gradle-wrapper.jar against Gradle's published checksums
+      - uses: gradle/actions/setup-gradle@ac638b010cf58a27ee6c972d7336334ccaf61c96 # v4.4.1
+
+      - name: Signing key
+        env:
+          KS: ${{ secrets.YGG_KEYSTORE_B64 }}
+        run: |
+          echo "$KS" | base64 -d > "$RUNNER_TEMP/ygg.p12"
+          echo "YGG_KEYSTORE=$RUNNER_TEMP/ygg.p12" >> "$GITHUB_ENV"
+
+      # "nouserlib": the build that can never load an outside native library
+      - name: Build
+        env:
+          YGG_KEYSTORE_PASSWORD: ${{ secrets.YGG_KEYSTORE_PASSWORD }}
+        run: |
+          chmod +x gradlew
+          ./gradlew :app:assembleNouserlib --no-daemon --stacktrace
+
+      - name: Security gate - no network, no contacts
+        run: |
+          APK=$(ls app/build/outputs/apk/nouserlib/*.apk | head -1)
+          AAPT2=$(ls -d "$ANDROID_HOME"/build-tools/*/aapt2 | sort -V | tail -1)
+          "$AAPT2" dump permissions "$APK" | tee permissions.txt
+          if grep -E "android.permission.(INTERNET|ACCESS_NETWORK_STATE|ACCESS_WIFI_STATE|READ_CONTACTS|CHANGE_NETWORK_STATE)" permissions.txt; then
+            echo "::error::Yggdrasil Keys must never ask for network or contacts access"; exit 1
+          fi
+          "$AAPT2" dump badging "$APK" | grep -E "^package:"
+          sha256sum "$APK" | tee "$APK.sha256"
+          echo "APK=$APK" >> "$GITHUB_ENV"
+
+      - uses: softprops/action-gh-release@72f2c25fcb47643c292f7107632f7a47c1df5cd8 # v2.3.2
+        with:
+          tag_name: keys-v4.2.${{ github.run_number }}
+          name: Yggdrasil Keys 4.2-ygg.${{ github.run_number }}
+          body: |
+            HeliBoard 4.2 with the Yggdrasil theme and runic letters. No network permission (checked by the build).
+            SHA-256 is attached alongside the APK.
+          files: |
+            ${{ env.APK }}
+            ${{ env.APK }}.sha256
diff --git a/YGGDRASIL.md b/YGGDRASIL.md
new file mode 100644
index 00000000..ee2360cc
--- /dev/null
+++ b/YGGDRASIL.md
@@ -0,0 +1,18 @@
+# Yggdrasil Keys
+
+A personal build of [HeliBoard](https://github.com/Helium314/HeliBoard) (GPL-3.0) with the Yggdrasil theme.
+
+Changes from upstream HeliBoard 4.2:
+
+- **Look**: "Yggdrasil" colour theme (night, gold, bone) is the default day and night; key labels use the
+  carved *Yggdrasil Runic* font unless you load your own font; rune-band background; key borders on.
+- **No network, ever**: `INTERNET`, `ACCESS_NETWORK_STATE`, `ACCESS_WIFI_STATE` are stripped with
+  `tools:node="remove"`, so Android blocks network access even if a library asked for it. CI fails the
+  build if any of them (or `READ_CONTACTS`) shows up in the APK.
+- **Nothing leaves the phone**: Android backup and phone-to-phone transfer are off for all app data.
+- **No outside native code**: built as `nouserlib`, which cannot load a user-supplied gesture library.
+- **Own identity**: package `com.ozorhaar.yggdrasil.keys` and provider authorities, so it installs next to HeliBoard.
+- **Supply chain**: GitHub Actions pinned to commit SHAs; Gradle wrapper checksum verified; APK signed with the
+  Yggdrasil key; SHA-256 published with each release.
+
+Updating from upstream: `git fetch upstream --tags && git rebase vX.Y` then fix any conflicts in the files above.
